# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets
.env

# Ingested data / generated indexes (regenerate via /ingest, don't commit)
data/uploads/*
!data/uploads/.gitkeep
data/kb/*
!data/kb/.gitkeep
data/images/*
!data/images/.gitkeep

# Evaluation artifacts (regenerate via `python -m app.eval.cli`)
data/eval/

# Test / tooling caches
.pytest_cache/
.uv-cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
data/dev-server.*.log

# Personal Claude Code overrides (.claude/settings.json is shared, this isn't)
.claude/settings.local.json

tests/
!/app/tests/
!/app/tests/*.py

previews/

# Generated evaluation runs and reports; keep the artifact guide in Git.
# Source fixtures live in app/eval; the protocol lives in docs.
/artifacts/*
!/artifacts/README.md
/output/
/tmp/
