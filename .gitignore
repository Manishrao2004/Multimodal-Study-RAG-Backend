# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets
.env

# Ingested data / generated indexes (regenerate via /ingest, don't commit)
data/uploads/*
!data/uploads/.gitkeep
data/kb/*
!data/kb/.gitkeep
data/images/*
!data/images/.gitkeep

# Evaluation artifacts (regenerate via `python -m app.eval.cli`)
data/eval/

# Test / tooling caches
.pytest_cache/

# Personal Claude Code overrides (.claude/settings.json is shared, this isn't)
.claude/settings.local.json

