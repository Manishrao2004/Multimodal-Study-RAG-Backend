# Copy this file to .env and adjust for your setup.
# Nothing here is vendor-specific — every model choice is swappable.
#
# Two working configurations are shown: a hosted one (any OpenAI-compatible
# gateway, e.g. Groq/OpenRouter/OpenAI) and a fully local one (Ollama), which
# is what the base paper uses. Embeddings and the reranker always run locally
# on CPU either way.

# --- LLM (answer generation) ---
# Options: ollama | openai_compatible | none
LLM_PROVIDER=openai_compatible
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# --- HyDE (query expansion for dense retrieval) ---
# Runs on every query — use a small, fast model here.
HYDE_PROVIDER=openai_compatible
HYDE_MODEL=openai/gpt-oss-20b
HYDE_BASE_URL=https://api.groq.com/openai/v1
HYDE_API_KEY=
HYDE_ENABLED=true

# --- VLM (diagram/figure captioning -> visual chunks) ---
# Options: ollama | openai_compatible | none
# Must be a model that accepts image input, or figures stay uncaptioned.
VLM_PROVIDER=none
VLM_MODEL=qwen/qwen3.8-27b
VLM_BASE_URL=https://api.groq.com/openai/v1
VLM_API_KEY=

# Figure filtering before captioning (drops icons, rules, logos, repeats)
VLM_MIN_WIDTH_PX=120
VLM_MIN_HEIGHT_PX=120
VLM_MIN_AREA_PX=40000
VLM_MAX_ASPECT_RATIO=6.0
VLM_PHASH_DISTANCE=4
VLM_MAX_IMAGES_PER_DOC=40

# --- Pasted screenshots / standalone images ---
SECURITY_MAX_SCREENSHOT_BYTES=10000000
SECURITY_MAX_SCREENSHOT_PIXELS=20000000
SCREENSHOT_MAX_DIMENSION_PX=4096

# --- ASR (lecture audio -> timestamped transcript chunks) ---
# Options: openai_compatible | faster_whisper | none
# faster_whisper runs locally and needs: uv add faster-whisper
ASR_PROVIDER=none
ASR_MODEL=whisper-large-v3-turbo
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_API_KEY=

# --- Embeddings (local, CPU) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Reranker (local, CPU) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning ---
BM25_TOP_K=20
FAISS_TOP_K=20
RRF_K=60
RERANK_TOP_K=5

# --- Attribution / grounding ---
ATTRIBUTION_ALPHA=0.7
ATTRIBUTION_BETA=0.3
GROUNDING_THRESHOLD=0.8

# --- Contradiction detection ---
# Measured on bge-small: unrelated pairs 0.47-0.52, real contradictions
# 0.82-0.89, paraphrases 0.91-1.00. The band is only a prefilter to drop
# unrelated pairs and duplicates — the LLM check decides actual conflict.
# Retune these if you change EMBEDDING_MODEL; the ranges are model-specific.
CONSENSUS_RELATED_MIN=0.70
CONSENSUS_AGREEMENT_MAX=0.97
CONSENSUS_MAX_PAIRS_VERIFIED=6

# --- Fully local alternative (base paper's setup) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma2:9b
# LLM_BASE_URL=http://localhost:11434
# HYDE_PROVIDER=ollama
# HYDE_MODEL=deepseek-r1:1.5b
# HYDE_BASE_URL=http://localhost:11434
# VLM_PROVIDER=ollama
# VLM_MODEL=llava-phi3
# VLM_BASE_URL=http://localhost:11434
# ASR_PROVIDER=faster_whisper
# ASR_MODEL=base
# Browser origins allowed to call the API. JSON syntax is required for lists.
# The built-in loopback regex also permits localhost/127.0.0.1 on any dev port.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
