# Copy this file to .env and adjust for your setup.
# Nothing here is mandatory to be Ollama-specific — swap providers freely.

# --- LLM (answer generation) ---
# Options: ollama | openai_compatible | none
LLM_PROVIDER=ollama
LLM_MODEL=gemma2:9b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# --- HyDE (query expansion for dense retrieval) ---
HYDE_PROVIDER=ollama
HYDE_MODEL=deepseek-r1:1.5b
HYDE_BASE_URL=http://localhost:11434
HYDE_API_KEY=
HYDE_ENABLED=true

# --- VLM (diagram/figure captioning) ---
# Options: ollama | openai_compatible | none
VLM_PROVIDER=none
VLM_MODEL=llava-phi3
VLM_BASE_URL=http://localhost:11434
VLM_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Example: using an OpenAI-compatible endpoint instead of Ollama
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
